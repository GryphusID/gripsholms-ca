# =============================================================================
#  ejbca-install.conf  -  configuration for the EJBCA v2 installer scripts
# =============================================================================
#  Used by: fetch-bundle.sh, install-ejbca.sh, and the add-on scripts in
#           $EJBCA_HOME/addons/<name>/ (install-ed25519.sh, uninstall-ed25519.sh)
#
#  Copy to e.g. /root/ejbca-install.conf, fill in EVERY value, then:
#       chown root:root /root/ejbca-install.conf
#       chmod 600       /root/ejbca-install.conf
#  The scripts refuse a config that is not owned by root or is readable /
#  writable by group or others (it contains passwords and is sourced by bash).
#
#  There are no defaults: every key below must have a value, except where it
#  says "mode ... only" (leave those empty in the other mode). A key that is
#  empty or missing stops the script before it changes anything.
#  Values are bash assignments: KEY="value" (no spaces around '=').
# =============================================================================

# -----------------------------------------------------------------------------
# Versions  (also used by fetch-bundle.sh to know what to download)
# -----------------------------------------------------------------------------
JAVA_MAJOR="21"
WILDFLY_VERSION="39.0.1.Final"
MARIADB_JDBC_VERSION="3.5.8"

# Release tags use <generation>.<ejbca-code>.<patch>: the middle number is the
# EJBCA version without dots (EJBCA 9.6.3 -> 2.963.x). The scripts check that
# both tags carry the code of EJBCA_VERSION.
#
# EJBCA version to install (src/internal.properties: app.version.number).
EJBCA_VERSION="9.6.3"
# GitHub repository (owner/name) the EJBCA source is downloaded from by
# fetch-bundle.sh, and its tag. The source includes the add-ons (addons/<name>/).
# A public repository needs no token; a private one needs GITHUB_TOKEN set.
EJBCA_REPO=""
EJBCA_PATCHES_TAG="2.963.0"
# Ed25519 add-on release expected inside that tag (addons/ed25519/VERSION).
ED25519_VERSION="2.963.0"

# Ubuntu packages installed from the bundle's local apt repository.
OS_PACKAGES="openjdk-21-jdk-headless ant ant-optional mariadb-server mariadb-client unzip curl"

# -----------------------------------------------------------------------------
# Paths  (WildFly paths, user and service are fixed by WildFly's systemd unit;
#         install-ejbca.sh checks these exact values)
# -----------------------------------------------------------------------------
BUNDLE_DIR="/opt/ejbca-bundle"
EJBCA_HOME="/opt/ejbca"
WILDFLY_HOME="/opt/wildfly"
WILDFLY_USER="wildfly"
WILDFLY_SERVICE="wildfly-standalone"

# -----------------------------------------------------------------------------
# Host
# -----------------------------------------------------------------------------
EJBCA_HOSTNAME="ca.example.org"     # CN + SAN of the TLS certificate (upgrade: the 7.x hostname)
DN_SUFFIX="O=Example,C=PT"          # appended to the ManagementCA, TLS and SuperAdmin DNs
HTTP_PORT="8080"
HTTPS_PORT="8443"
HEAP_SIZE_MB="2048"

# -----------------------------------------------------------------------------
# Database (local MariaDB)
# -----------------------------------------------------------------------------
DB_ROOT_PASS=""
DB_NAME="ejbca"
DB_USER="ejbca"
DB_PASS=""

# -----------------------------------------------------------------------------
# EJBCA secrets
# -----------------------------------------------------------------------------
# Encrypts sensitive values stored in the database (crypto token PINs, etc.).
# Set it once, before the first install, and NEVER change it afterwards.
# Mode upgrade-from-7x: the 7.x instance's value. If the 7.x
# conf/cesecore.properties has no password.encryption.key line, write
# "default" (EJBCA's built-in key; the line is then left out here too).
# If the 7.x instance set password.encryption.count, stop: not supported.
PBE_ENCRYPTION_KEY=""
# TLS keystore / truststore passwords (at least 6 characters).
# Mode upgrade-from-7x: the passwords of the 7.x keystores below
# (7.x conf/web.properties: httpsserver.password, java.trustpassword).
KS_PASS=""
TS_PASS=""
SUPERADMIN_PASS=""    # superadmin.p12 password - mode fresh only

# -----------------------------------------------------------------------------
# Upgrade from 7.x - mode upgrade-from-7x only (leave empty for mode fresh)
# -----------------------------------------------------------------------------
# Taken from the 7.x instance AFTER stopping its WildFly for good:
#   database:  mysqldump --single-transaction --routines --triggers <db> | gzip > ejbca-7x.sql.gz
#              (no --databases option: the dump must not contain CREATE DATABASE/USE)
#   keystores: <7.x WildFly>/standalone/configuration/keystore/keystore.jks (or .p12)
#              and truststore.jks (or .p12)
# The 7.x TLS certificate is reused, so EJBCA_HOSTNAME should be the 7.x hostname.
UPGRADE_DB_DUMP=""          # e.g. /root/ejbca-7x.sql.gz (.sql or .sql.gz)
UPGRADE_TLS_KEYSTORE=""     # e.g. /root/7x/keystore.jks
UPGRADE_TLS_TRUSTSTORE=""   # e.g. /root/7x/truststore.jks

# -----------------------------------------------------------------------------
# HSM (Utimaco) - installed by the client before running the installer
# -----------------------------------------------------------------------------
P11_LIB_NAME="Utimaco PKCS#11 R3"
P11_LIB_FILE="/etc/utimaco/libcs_pkcs11_R3.so"
# Utimaco library configuration. Passed to WildFly as CS_PKCS11_R3_CFG; must be
# readable by the wildfly user, and its Logpath writable by it.
HSM_CFG_FILE="/etc/utimaco/cs_pkcs11_R3.cfg"
